# Copy to trias-proxy/.env and fill in real values.
# Do NOT commit the resulting .env file (it holds a secret API key).
#
# No quotes around values — this file is sourced both by shell scripts
# (`export $(grep -v '^#' .env | xargs)`) and by systemd's EnvironmentFile=,
# both of which expect plain KEY=VALUE lines.

TRIAS_PROXY_API_KEY=CHANGE_ME
GTFS_DB_PATH=/absolute/path/to/trias-proxy/gtfs_seed.sqlite
LOCATIONS_DB_PATH=/absolute/path/to/trias-proxy/locations.sqlite

# Optional: only needed if the live TRIAS proxy is enabled.
# TRIAS_ENDPOINT=https://example.org/trias
